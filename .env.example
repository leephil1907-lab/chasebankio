# chasebankio — environment configuration
# Copy to `.env` and adjust. Values below (except secrets) are the dev defaults.

# --- core -------------------------------------------------------------------
PORT=8123
HOST=0.0.0.0
NODE_ENV=development
# Where the JSON datastore lives (relative to repo root or absolute).
DATA_DIR=data

# --- console integration ----------------------------------------------------
# The external operator console (NOT part of this repo) receives forwarded
# events (sign-ups, support cases, password-reset deliveries).
CONSOLE_URL=http://127.0.0.1:7788
# Token the console presents to /api/admin/* — must match its ADMIN_API_TOKEN.
# Generate: openssl rand -hex 16   (REQUIRED in production)
ADMIN_API_TOKEN=local-dev-admin-token

# --- security (REQUIRED in production) --------------------------------------
# Generate: openssl rand -hex 32   (REQUIRED in production)
SESSION_SECRET=
# 1 → session cookies get the Secure flag (REQUIRED in production)
COOKIE_SECURE=0
# 1 → send HSTS (only when serving over HTTPS)
HSTS=0
# 1 → trust X-Forwarded-For when behind a reverse proxy
TRUST_PROXY=0
# Who may embed pages in frames (CSP frame-ancestors).
# Preview sandbox needs the default '*'; production example: 'self'
FRAME_ANCESTORS=*
# Extra allowed browser origins for API calls (comma separated), if any.
ALLOWED_ORIGINS=
